<%- include('partials/header') %>
<div class="container mt-5">
    <div class="card shadow-lg border-0" style="border-radius: 20px;">
        <div class="card-body p-5">
            <h2 class="fw-bold text-primary mb-4"><i class="fas fa-clipboard-list me-2"></i>Assessment Instructions</h2>
            
            <div class="alert alert-info border-0 rounded-3">
                <h5 class="fw-bold"><i class="fas fa-book me-2"></i>Topic: <%= topic %></h5>
                <p class="mb-0">Please read the instructions carefully before starting.</p>
            </div>

            <div class="row mt-4">
                <div class="col-md-8">
                    <h5 class="fw-bold">Exam Rules:</h5>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item"><i class="fas fa-clock text-warning me-2"></i> <strong>Duration:</strong> 15 Minutes</li>
                        <li class="list-group-item"><i class="fas fa-list-ol text-primary me-2"></i> <strong>Questions:</strong> 15 Questions</li>
                        <li class="list-group-item"><i class="fas fa-ban text-danger me-2"></i> <strong>Navigation:</strong> Do not switch tabs (Warning Enabled).</li>
                        <li class="list-group-item"><i class="fas fa-check-circle text-success me-2"></i> <strong>Marking:</strong> No negative marking.</li>
                    </ul>
                </div>
                
                <div class="col-md-4 bg-light p-4 rounded-3 text-center">
                    <h5 class="fw-bold mb-3">Select Difficulty</h5>
                    <form action="/start-exam" method="GET">
                        <input type="hidden" name="topic" value="<%= topic %>">
                        
                        <div class="d-grid gap-2">
                            <input type="radio" class="btn-check" name="difficulty" id="easy" value="Basic" checked>
                            <label class="btn btn-outline-success" for="easy">Basic (Easy)</label>

                            <input type="radio" class="btn-check" name="difficulty" id="medium" value="Medium">
                            <label class="btn btn-outline-warning" for="medium">Intermediate (Medium)</label>

                            <input type="radio" class="btn-check" name="difficulty" id="hard" value="Advanced">
                            <label class="btn btn-outline-danger" for="hard">Advanced (Hard)</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4 fw-bold py-2">
                            Start Assessment <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>