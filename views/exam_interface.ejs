<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>MNC Exam Interface</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #eef2f3; height: 100vh; overflow: hidden; user-select: none; }
        .exam-header { background: white; padding: 15px 30px; border-bottom: 2px solid #ddd; display: flex; justify-content: space-between; align-items: center; }
        .timer-box { background: #dc3545; color: white; padding: 8px 20px; border-radius: 8px; font-weight: bold; font-size: 1.2rem; }
        
        .main-area { display: flex; height: calc(100vh - 130px); padding: 15px; gap: 15px; }
        
        /* Left Side: Question */
        .q-box { flex: 3; background: white; border-radius: 10px; padding: 30px; overflow-y: auto; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .q-num { color: #0d6efd; font-weight: bold; font-size: 1.1rem; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
        .q-text { font-size: 1.2rem; margin-bottom: 30px; font-weight: 500; }
        
        .opt-btn { display: block; width: 100%; text-align: left; padding: 15px; margin-bottom: 15px; background: #f8f9fa; border: 2px solid #dee2e6; border-radius: 8px; font-size: 1.1rem; cursor: pointer; transition: 0.2s; }
        .opt-btn:hover { background: #e9ecef; }
        .opt-btn.active { background: #e7f1ff; border-color: #0d6efd; font-weight: bold; }

        /* Right Side: Palette */
        .palette-box { flex: 1; background: white; border-radius: 10px; padding: 20px; display: flex; flex-direction: column; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .grid-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; overflow-y: auto; padding-right: 5px; }
        .grid-item { height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 5px; border: 1px solid #ccc; cursor: pointer; font-weight: bold; }
        
        .ans { background: #198754; color: white; border: none; }
        .not-ans { background: #dc3545; color: white; border: none; }
        .review { background: #6f42c1; color: white; border: none; }
        .current { border: 3px solid #000; box-shadow: inset 0 0 0 2px white; }

        /* Footer */
        .exam-footer { background: white; padding: 15px 30px; border-top: 2px solid #ddd; position: absolute; bottom: 0; width: 100%; display: flex; justify-content: space-between; }
        
        /* Overlay */
        #start-overlay { position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.9); z-index: 1000; display: flex; align-items: center; justify-content: center; color: white; flex-direction: column; }
    </style>
</head>
<body>

    <div id="start-overlay">
        <i class="fas fa-shield-alt fa-4x text-success mb-3"></i>
        <h2>Secure Testing Environment</h2>
        <p>Your screen will be locked. Do not exit full screen.</p>
        <button class="btn btn-success btn-lg mt-3" onclick="startTest()">Start Test Now</button>
    </div>

    <div class="exam-header">
        <h4 class="m-0 fw-bold"><%= topic %></h4>
        <div class="timer-box"><i class="fas fa-clock me-2"></i><span id="time-display">60:00</span></div>
    </div>

    <div class="main-area">
        <div class="q-box">
            <div class="q-num" id="q-num-display">Question 1</div>
            <div class="q-text" id="q-text-display">Loading...</div>
            <div id="options-container"></div>
        </div>

        <div class="palette-box">
            <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                <div>
                    <h6 class="m-0 fw-bold"><%= user.username %></h6>
                    <small class="text-muted">Candidate</small>
                </div>
            </div>
            <h6 class="text-muted small fw-bold mb-3">QUESTION PALETTE</h6>
            <div class="grid-container" id="palette"></div>
        </div>
    </div>

    <div class="exam-footer">
        <div>
            <button class="btn btn-outline-danger me-2" onclick="clearAns()">Clear Response</button>
            <button class="btn btn-warning text-white" onclick="markReview()">Mark for Review</button>
        </div>
        <div>
            <button class="btn btn-secondary me-2" onclick="goPrev()">Previous</button>
            <button class="btn btn-primary me-4" onclick="goNext()">Save & Next</button>
            <button class="btn btn-success fw-bold px-4" onclick="submitExam()">SUBMIT EXAM</button>
        </div>
    </div>

    <form id="submit-form" action="/submit-grand-exam" method="POST" style="display:none;">
        <input type="hidden" name="payload" id="payload">
    </form>

    <script>
        const questions = <%- JSON.stringify(questions) %>;
        const totalTime = <%= duration %> * 60; 
        let timeLeft = totalTime;
        let curr = 0;
        let answers = new Array(questions.length).fill(null);
        let status = new Array(questions.length).fill('not-visited'); // answered, not-answered, review
        let timerId;

        function startTest() {
            document.getElementById('start-overlay').style.display = 'none';
            document.documentElement.requestFullscreen().catch(e=>console.log(e));
            buildPalette();
            showQ(0);
            timerId = setInterval(updateTime, 1000);
        }

        function updateTime() {
            timeLeft--;
            let m = Math.floor(timeLeft/60);
            let s = timeLeft%60;
            document.getElementById('time-display').innerText = `${m}:${s<10?'0':''}${s}`;
            if(timeLeft <= 0) submitExam();
        }

        function buildPalette() {
            let html = '';
            for(let i=0; i<questions.length; i++){
                html += `<div class="grid-item" id="box-${i}" onclick="showQ(${i})">${i+1}</div>`;
            }
            document.getElementById('palette').innerHTML = html;
        }

        function showQ(idx) {
            curr = idx;
            let q = questions[idx];
            document.getElementById('q-num-display').innerHTML = `Question ${idx+1} of ${questions.length} <span class="badge bg-secondary ms-2">${q.category}</span>`;
            document.getElementById('q-text-display').innerText = q.question;
            
            let optsHtml = `
                <button class="opt-btn ${answers[idx]==='A'?'active':''}" onclick="setAns('A')">A. ${q.option_a}</button>
                <button class="opt-btn ${answers[idx]==='B'?'active':''}" onclick="setAns('B')">B. ${q.option_b}</button>
                <button class="opt-btn ${answers[idx]==='C'?'active':''}" onclick="setAns('C')">C. ${q.option_c}</button>
                <button class="opt-btn ${answers[idx]==='D'?'active':''}" onclick="setAns('D')">D. ${q.option_d}</button>
            `;
            document.getElementById('options-container').innerHTML = optsHtml;
            updateColors();
        }

        function setAns(opt) {
            answers[curr] = opt;
            status[curr] = 'answered';
            showQ(curr);
        }

        function clearAns() {
            answers[curr] = null;
            status[curr] = 'not-answered';
            showQ(curr);
        }

        function markReview() {
            status[curr] = 'review';
            goNext();
        }

        function goNext() {
            if(status[curr] === 'not-visited' && !answers[curr]) status[curr] = 'not-answered';
            if(curr < questions.length-1) showQ(curr+1);
            else updateColors();
        }

        function goPrev() {
            if(curr > 0) showQ(curr-1);
        }

        function updateColors() {
            for(let i=0; i<questions.length; i++) {
                let b = document.getElementById(`box-${i}`);
                b.className = 'grid-item';
                if(status[i] === 'answered') b.classList.add('ans');
                if(status[i] === 'not-answered') b.classList.add('not-ans');
                if(status[i] === 'review') b.classList.add('review');
                if(i === curr) b.classList.add('current');
            }
        }

        function submitExam() {
            clearInterval(timerId);
            let payload = { questions: questions, answers: answers, topic: "Mega Test" };
            document.getElementById('payload').value = JSON.stringify(payload);
            document.getElementById('submit-form').submit();
        }

        // Anti-Cheat
        document.addEventListener("visibilitychange", () => {
            if (document.hidden) alert("WARNING: Do not switch tabs during the exam!");
        });
    </script>
</body>
</html>