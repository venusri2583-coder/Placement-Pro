<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PlacementPro Assessment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f0f2f5; height: 100vh; overflow: hidden; font-family: 'Segoe UI', sans-serif; }
        
        /* HEADER */
        .exam-header { height: 60px; background: #fff; border-bottom: 1px solid #ddd; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .timer-box { background: #2c3e50; color: #fff; padding: 5px 15px; border-radius: 5px; font-weight: bold; font-size: 1.2rem; }
        
        /* MAIN LAYOUT */
        .exam-container { display: flex; height: calc(100vh - 120px); }
        
        /* QUESTION AREA (Left) */
        .question-area { flex: 3; padding: 30px; overflow-y: auto; background: #fff; margin: 15px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .q-number { font-size: 1.1rem; font-weight: bold; color: #3498db; margin-bottom: 15px; }
        .q-text { font-size: 1.2rem; margin-bottom: 25px; line-height: 1.6; }
        .option-box { display: block; padding: 12px 15px; margin-bottom: 12px; border: 2px solid #e9ecef; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        .option-box:hover { background: #f8f9fa; border-color: #adb5bd; }
        .option-box.selected { border-color: #3498db; background: #ebf5fb; font-weight: 600; }
        
        /* PALETTE AREA (Right) */
        .palette-area { flex: 1; background: #fff; margin: 15px 15px 15px 0; border-radius: 10px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: flex; flex-direction: column; }
        .student-info { display: flex; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 15px; }
        .grid-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; overflow-y: auto; }
        .grid-item { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; cursor: pointer; border: 1px solid #ddd; background: #fff; color: #333; }
        
        /* Palette Colors */
        .grid-item.answered { background: #2ecc71; color: white; border: none; }
        .grid-item.not-answered { background: #e74c3c; color: white; border: none; }
        .grid-item.review { background: #9b59b6; color: white; border: none; }
        .grid-item.current { border: 2px solid #3498db; }

        /* FOOTER */
        .exam-footer { height: 60px; background: #fff; border-top: 1px solid #ddd; padding: 0 30px; display: flex; align-items: center; justify-content: space-between; position: fixed; bottom: 0; width: 100%; }
        
        /* Full Screen Overlay */
        #fullscreen-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 9999; display: flex; align-items: center; justify-content: center; color: white; flex-direction: column; }
    </style>
</head>
<body>

    <div id="fullscreen-overlay">
        <h2><i class="fas fa-lock me-2"></i>Secure Exam Environment</h2>
        <p>Please click the button below to enter Full Screen mode and start.</p>
        <button class="btn btn-primary btn-lg" onclick="startExam()">Start Test Now</button>
    </div>

    <div class="exam-header">
        <h4 class="m-0 fw-bold text-primary"><%= topic %> <span class="badge bg-secondary ms-2" style="font-size: 0.8rem;"><%= difficulty %></span></h4>
        <div class="timer-box"><i class="fas fa-stopwatch me-2"></i><span id="timer">15:00</span></div>
    </div>

    <div class="exam-container">
        
        <div class="question-area">
            <div id="question-container">
                </div>
        </div>

        <div class="palette-area">
            <div class="student-info">
                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; font-size: 1.2rem;">
                    <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <h6 class="m-0 fw-bold"><%= user.username %></h6>
                    <small class="text-muted"><%= user.email %></small>
                </div>
            </div>
            
            <h6 class="text-muted text-uppercase small fw-bold mb-3">Question Palette</h6>
            <div class="grid-container" id="palette-grid">
                </div>
            
            <div class="mt-auto pt-3 border-top small text-muted">
                <div class="d-flex align-items-center mb-1"><span class="badge bg-success me-2 rounded-circle p-1" style="width:10px; height:10px;"> </span> Answered</div>
                <div class="d-flex align-items-center mb-1"><span class="badge bg-danger me-2 rounded-circle p-1" style="width:10px; height:10px;"> </span> Not Answered</div>
                <div class="d-flex align-items-center"><span class="badge bg-secondary me-2 rounded-circle p-1" style="width:10px; height:10px;"> </span> Not Visited</div>
            </div>
        </div>
    </div>

    <div class="exam-footer">
        <div>
            <button class="btn btn-outline-secondary me-2" onclick="clearResponse()">Clear Response</button>
            <button class="btn btn-warning text-white" onclick="markForReview()">Mark for Review</button>
        </div>
        <div>
            <button class="btn btn-secondary me-2" onclick="prevQuestion()" id="btn-prev">Previous</button>
            <button class="btn btn-primary me-3" onclick="nextQuestion()" id="btn-next">Save & Next</button>
            <button class="btn btn-success fw-bold" onclick="submitExam()">Submit Test</button>
        </div>
    </div>

    <form id="submit-form" action="/submit-exam" method="POST" style="display:none;">
        <input type="hidden" name="payload" id="payload">
    </form>

    <script>
        // --- 1. DATA SETUP ---
        const questions = <%- JSON.stringify(questions) %>;
        const topicName = "<%= topic %>";
        let currentQIndex = 0;
        let userAnswers = new Array(questions.length).fill(null); // Stores A, B, C, D
        let questionStatus = new Array(questions.length).fill('not-visited'); // answered, review, not-answered
        let timeLeft = 15 * 60; // 15 Minutes
        let timerInterval;

        // --- 2. INITIALIZATION ---
        function startExam() {
            document.getElementById('fullscreen-overlay').style.display = 'none';
            document.documentElement.requestFullscreen().catch((e) => console.log(e));
            renderPalette();
            loadQuestion(0);
            startTimer();
        }

        // --- 3. TIMER LOGIC ---
        function startTimer() {
            timerInterval = setInterval(() => {
                let m = Math.floor(timeLeft / 60);
                let s = timeLeft % 60;
                document.getElementById('timer').innerText = `${m}:${s < 10 ? '0' : ''}${s}`;
                timeLeft--;
                if (timeLeft < 0) submitExam();
            }, 1000);
        }

        // --- 4. QUESTION RENDERING ---
        function loadQuestion(index) {
            currentQIndex = index;
            const q = questions[index];
            const savedAns = userAnswers[index];

            let html = `
                <div class="d-flex justify-content-between">
                    <div class="q-number">Question ${index + 1} of ${questions.length}</div>
                    <span class="badge bg-info text-dark mb-3">${q.difficulty || 'Medium'}</span>
                </div>
                <div class="q-text">${q.question}</div>
                
                <div class="option-box ${savedAns === 'A' ? 'selected' : ''}" onclick="selectOption('A')">A. ${q.option_a}</div>
                <div class="option-box ${savedAns === 'B' ? 'selected' : ''}" onclick="selectOption('B')">B. ${q.option_b}</div>
                <div class="option-box ${savedAns === 'C' ? 'selected' : ''}" onclick="selectOption('C')">C. ${q.option_c}</div>
                <div class="option-box ${savedAns === 'D' ? 'selected' : ''}" onclick="selectOption('D')">D. ${q.option_d}</div>
            `;
            document.getElementById('question-container').innerHTML = html;
            
            // Button State
            document.getElementById('btn-prev').disabled = (index === 0);
            document.getElementById('btn-next').innerText = (index === questions.length - 1) ? "Save & Submit" : "Save & Next";
            
            updatePalette();
        }

        function selectOption(opt) {
            userAnswers[currentQIndex] = opt;
            questionStatus[currentQIndex] = 'answered';
            loadQuestion(currentQIndex); // Re-render to show selection
        }

        function clearResponse() {
            userAnswers[currentQIndex] = null;
            questionStatus[currentQIndex] = 'not-answered';
            loadQuestion(currentQIndex);
        }

        function markForReview() {
            questionStatus[currentQIndex] = 'review';
            nextQuestion();
        }

        // --- 5. NAVIGATION ---
        function nextQuestion() {
            if (currentQIndex < questions.length - 1) {
                if(questionStatus[currentQIndex] === 'not-visited' && !userAnswers[currentQIndex]) {
                    questionStatus[currentQIndex] = 'not-answered';
                }
                loadQuestion(currentQIndex + 1);
            } else {
                submitExam();
            }
        }

        function prevQuestion() {
            if (currentQIndex > 0) {
                loadQuestion(currentQIndex - 1);
            }
        }

        // --- 6. PALETTE LOGIC ---
        function renderPalette() {
            let html = '';
            for(let i=0; i<questions.length; i++) {
                html += `<div id="p-${i}" class="grid-item" onclick="loadQuestion(${i})">${i+1}</div>`;
            }
            document.getElementById('palette-grid').innerHTML = html;
        }

        function updatePalette() {
            for(let i=0; i<questions.length; i++) {
                let el = document.getElementById(`p-${i}`);
                el.className = 'grid-item'; // Reset
                if (i === currentQIndex) el.classList.add('current');
                if (questionStatus[i] === 'answered') el.classList.add('answered');
                if (questionStatus[i] === 'not-answered') el.classList.add('not-answered');
                if (questionStatus[i] === 'review') el.classList.add('review');
            }
        }

        // --- 7. SUBMISSION ---
        function submitExam() {
            clearInterval(timerInterval);
            const payload = {
                topic: topicName,
                answers: userAnswers
            };
            document.getElementById('payload').value = JSON.stringify(payload);
            document.getElementById('submit-form').submit();
        }

        // --- 8. SECURITY (TAB SWITCH WARNING) ---
        document.addEventListener("visibilitychange", function() {
            if (document.hidden) {
                alert("⚠️ WARNING: Tab switching is monitored! Please stay on the exam screen.");
            }
        });

    </script>
</body>
</html>