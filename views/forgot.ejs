<%- include('partials/header') %>

<div class="elite-wrapper">
    <div class="cinematic-bg" style="background-image: linear-gradient(rgba(10, 15, 30, 0.85), rgba(10, 15, 30, 0.98)), url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=2070');"></div>

    <div class="portal-container animate__animated animate__zoomIn">
        <div class="split-glass-box">
            
            <div class="brand-panel">
                <div class="brand-content">
                    <div class="status-indicator animate__animated animate__fadeIn" style="color: #f43f5e; border-color: rgba(244, 63, 94, 0.3); background: rgba(244, 63, 94, 0.1);">
                        ACCOUNT RECOVERY
                    </div>
                    
                    <h1 class="master-heading animated-title">
                        Secure <br><span style="color: #f43f5e; text-shadow: 0 0 35px rgba(244, 63, 94, 0.5);">Reset Process</span>
                    </h1>
                    
                    <p class="tagline animate__animated animate__fadeIn animate__delay-1s">
                        Don't worry, it happens to the best of us. We'll help you get back to your preparation in no time.
                    </p>
                    
                    <div class="feature-badges animate__animated animate__fadeIn animate__delay-2s">
                        <span><i class="fas fa-shield-alt"></i> Identity Check</span>
                        <span><i class="fas fa-key"></i> Safe Restore</span>
                    </div>
                </div>
            </div>

            <div class="form-panel">
                <div class="auth-box">
                    <h2 class="fw-bold text-dark mb-1">Find Account</h2>
                    <p class="text-muted small mb-4">Enter your email to verify identity</p>

                    <% if (error) { %> 
                        <div class="alert alert-danger pro-alert py-2 small animate__animated animate__shakeX">
                            <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                        </div> 
                    <% } %>

                    <form action="/get-question" method="POST">
                        
                        <div class="modern-field mb-4">
                            <label><i class="fas fa-envelope-open-text me-2"></i>Registered Email</label>
                            <input type="email" name="email" placeholder="name@college.edu" required value="<%= typeof email != 'undefined' ? email : '' %>">
                        </div>
                        
                        <button type="submit" class="btn-elite-action" style="background: #f43f5e;">
                            Verify & Continue <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </form>
                    
                    <div class="text-center mt-4">
                        <a href="/login" class="small text-muted fw-bold" style="text-decoration: none;">
                            <i class="fas fa-arrow-left me-1"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Styling copied from Login Page for consistency */
    @keyframes slideInMoving {
        0% { opacity: 0; transform: translateX(-80px) skewX(-10deg); }
        100% { opacity: 1; transform: translateX(0) skewX(0deg); }
    }
    .animated-title {
        animation: slideInMoving 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        text-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    .elite-wrapper { height: 100vh; width: 100vw; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: #020617; }
    .cinematic-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: cover; background-position: center; z-index: -1; animation: subtleZoom 20s infinite alternate; }
    @keyframes subtleZoom { from { transform: scale(1); } to { transform: scale(1.1); } }

    .split-glass-box { display: flex; width: 90%; max-width: 1100px; min-height: 600px; background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(25px); border-radius: 40px; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; box-shadow: 0 50px 100px rgba(0,0,0,0.6); }
    
    .brand-panel { flex: 1.2; padding: 70px; display: flex; align-items: center; color: white; border-right: 1px solid rgba(255,255,255,0.05); }
    .master-heading { font-family: 'Outfit', sans-serif; font-size: 3.5rem; font-weight: 800; line-height: 0.9; letter-spacing: -2px; }
    
    .status-indicator { display: inline-block; padding: 5px 15px; border-radius: 100px; font-size: 0.7rem; font-weight: 700; margin-bottom: 20px; letter-spacing: 2px; }
    .tagline { margin-top: 25px; font-size: 1.1rem; color: rgba(255,255,255,0.7); line-height: 1.6; }
    .feature-badges { display: flex; gap: 15px; margin-top: 35px; }
    .feature-badges span { background: rgba(255,255,255,0.05); padding: 10px 20px; border-radius: 12px; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.1); }

    .form-panel { flex: 1; background: white; padding: 60px; display: flex; align-items: center; justify-content: center; }
    .auth-box { width: 100%; max-width: 360px; }
    .modern-field label { display: block; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 8px; }
    .modern-field input { width: 100%; padding: 16px; border-radius: 15px; border: 1.5px solid #e2e8f0; background: #f8fafc; outline: none; transition: 0.3s; font-size: 0.95rem; }
    .modern-field input:focus { border-color: #f43f5e; background: white; box-shadow: 0 10px 20px rgba(244, 63, 94, 0.1); }

    .btn-elite-action { width: 100%; padding: 18px; border-radius: 18px; color: white; border: none; font-weight: 700; transition: 0.3s; cursor: pointer; }
    .btn-elite-action:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(244, 63, 94, 0.4); filter: brightness(1.1); }
    
    @media (max-width: 992px) { .brand-panel { display: none; } .split-glass-box { max-width: 500px; } }
</style>

<%- include('partials/footer') %>