<%- include('partials/header') %>

<div class="container-fluid py-3" style="background-color: #f0f2f5; min-height: 100vh;">
    <div class="row">
        <div class="col-md-9">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 text-uppercase fw-bold">ELITE MOCK TEST</h6>
                    <span class="badge bg-secondary">meme <i class="bi bi-person-circle"></i></span>
                </div>
                <div class="card-body bg-light py-2">
                    <span class="fw-bold"><%= topic %></span>
                </div>
                
                <div class="card-body p-4" id="exam-area" style="min-height: 450px;">
                    <% questions.forEach((q, index) => { %>
                        <div class="question-container" id="q-<%= index %>" style="display: <%= index === 0 ? 'block' : 'none' %>;">
                            <p class="fw-bold mb-4">Q<%= index + 1 %>: <%= q.question %></p>
                            <div class="options ps-3">
                                <% ['a', 'b', 'c', 'd'].forEach(opt => { %>
                                    <div class="form-check mb-3 border p-2 rounded option-row" onclick="selectOption(<%= index %>, '<%= opt.toUpperCase() %>')">
                                        <input class="form-check-input ms-1" type="radio" name="ans<%= index %>" id="opt_<%= index %>_<%= opt %>" value="<%= opt.toUpperCase() %>">
                                        <label class="form-check-label ms-2 w-100" style="cursor:pointer;" for="opt_<%= index %>_<%= opt %>">
                                            <%= opt.toUpperCase() %>) <%= q['option_' + opt] %>
                                        </label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="card-footer bg-white d-flex justify-content-between">
                    <button class="btn btn-outline-secondary" onclick="clearResponse()">Clear Response</button>
                    <button class="btn btn-primary" style="background-color: #5d5dff;" onclick="markForReview()">Mark for Review</button>
                    <div class="ms-auto">
                        <button class="btn btn-success me-2" onclick="saveAndNext()">Save & Next</button>
                        <button class="btn btn-primary" onclick="submitExam()">SUBMIT TEST</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-2 text-center bg-dark text-white rounded-top">
                    <span class="fw-bold">Time Left: <span id="timer">15:00</span></span>
                </div>
                <div class="card-body">
                    <div class="row g-2 text-center mb-3">
                        <div class="col-6"><small><span class="badge bg-success" id="stat-ans">0</span> Answered</small></div>
                        <div class="col-6"><small><span class="badge bg-danger" id="stat-notans">0</span> Not Answered</small></div>
                        <div class="col-6"><small><span class="badge bg-light text-dark border" id="stat-visited">0</span> Not Visited</small></div>
                        <div class="col-6"><small><span class="badge bg-primary" id="stat-review">0</span> Review</small></div>
                    </div>
                    
                    <div class="palette-header bg-info text-white text-center py-1 mb-2">Question Palette</div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center overflow-auto" style="max-height: 300px;">
                        <% questions.forEach((_, i) => { %>
                            <button class="btn btn-light border p-0 palette-btn" id="btn-<%= i %>" style="width: 40px; height: 40px;" onclick="goToQuestion(<i %>)"><%= i + 1 %></button>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentIdx = 0;
    let totalQs = <%= questions.length %>;
    let time = 15 * 60; // 15 Minutes
    let answers = new Array(totalQs).fill(null);
    let status = new Array(totalQs).fill(0); // 0: Not Visited, 1: Visited/Not Answered, 2: Answered, 3: Review

    // Initialize first question
    status[0] = 1;

    // Timer Logic
    const timerTick = setInterval(() => {
        if(time <= 0) { clearInterval(timerTick); submitExam(); }
        let m = Math.floor(time/60), s = time % 60;
        document.getElementById('timer').innerText = `${m}:${s < 10 ? '0'+s : s}`;
        time--;
    }, 1000);

    function updateUI() {
        // Show/Hide Questions
        document.querySelectorAll('.question-container').forEach((el, i) => el.style.display = i === currentIdx ? 'block' : 'none');
        
        // Update Palette Colors
        status.forEach((s, i) => {
            let btn = document.getElementById(`btn-${i}`);
            btn.className = "btn p-0 palette-btn"; // reset
            if(i === currentIdx) btn.classList.add('border-dark', 'border-3');
            if(s === 2) btn.classList.add('bg-success', 'text-white');
            else if(s === 3) btn.classList.add('bg-primary', 'text-white');
            else if(s === 1) btn.classList.add('bg-danger', 'text-white');
            else btn.classList.add('bg-light');
        });

        // Update Counts
        document.getElementById('stat-ans').innerText = status.filter(s => s === 2).length;
        document.getElementById('stat-notans').innerText = status.filter(s => s === 1).length;
        document.getElementById('stat-visited').innerText = status.filter(s => s === 0).length;
        document.getElementById('stat-review').innerText = status.filter(s => s === 3).length;
    }

    function selectOption(qIdx, opt) {
        answers[qIdx] = opt;
        document.getElementById(`opt_${qIdx}_${opt.toLowerCase()}`).checked = true;
    }

    function saveAndNext() {
        status[currentIdx] = answers[currentIdx] ? 2 : 1;
        if(currentIdx < totalQs - 1) { currentIdx++; if(status[currentIdx] === 0) status[currentIdx] = 1; }
        updateUI();
    }

    function markForReview() {
        status[currentIdx] = 3;
        if(currentIdx < totalQs - 1) { currentIdx++; if(status[currentIdx] === 0) status[currentIdx] = 1; }
        updateUI();
    }

    function goToQuestion(i) { currentIdx = i; if(status[i] === 0) status[i] = 1; updateUI(); }
    
    function clearResponse() {
        answers[currentIdx] = null;
        document.querySelectorAll(`input[name="ans${currentIdx}"]`).forEach(r => r.checked = false);
        status[currentIdx] = 1;
        updateUI();
    }

    function submitExam() {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/submit-exam';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'payload';
        input.value = JSON.stringify({ topic: '<%= topic %>', answers: answers });
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }

    updateUI(); // Initial run
</script>

<%- include('partials/footer') %>