<%- include('partials/header') %>

<div class="elite-wrapper">
    <div class="cinematic-bg" style="background-image: linear-gradient(rgba(10, 15, 30, 0.85), rgba(10, 15, 30, 0.98)), url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=2070');"></div>

    <div class="portal-container animate__animated animate__zoomIn">
        <div class="split-glass-box">
            
            <div class="brand-panel">
                <div class="brand-content">
                    <div class="status-indicator animate__animated animate__fadeIn">SECURE ENROLLMENT</div>
                    
                    <h1 class="master-heading animated-title">
                        Placement <br><span>Hub</span>
                    </h1>
                    
                    <p class="tagline animate__animated animate__fadeIn animate__delay-1s">
                        Register to unlock your professional potential today.
                    </p>
                    
                    <div class="feature-badges animate__animated animate__fadeIn animate__delay-2s">
                        <span><i class="fas fa-shield-alt"></i> Corporate Ready</span>
                    </div>
                </div>
            </div>

            <div class="form-panel">
                <div class="auth-box">
                    <h2 class="fw-bold text-dark mb-1" style="font-size: 1.5rem;">Create Account</h2>
                    <p class="text-muted small mb-3">Join the elite preparation hub</p>

                    <% if (error) { %> 
                        <div class="alert alert-danger pro-alert py-1 small animate__animated animate__shakeX">
                            <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                        </div> 
                    <% } %>

                    <form action="/register" method="POST">
                        <div class="row">
                            <div class="col-12 modern-field mb-2">
                                <label><i class="fas fa-user-circle me-2"></i>Full Name</label>
                                <input type="text" name="username" placeholder="Enter full name" required>
                            </div>

                            <div class="col-12 modern-field mb-2">
                                <label><i class="fas fa-envelope-open me-2"></i>College Email</label>
                                <input type="email" name="email" placeholder="name@college.edu" required>
                            </div>

                            <div class="col-12 modern-field mb-2">
                                <label><i class="fas fa-fingerprint me-2"></i>Password</label>
                                <input type="password" name="password" placeholder="••••••••" required>
                            </div>

                            <div class="col-12 modern-field mb-2">
                                <label><i class="fas fa-question-circle me-2"></i>Security Question</label>
                                <select name="security_question" class="form-select" required>
                                    <option value="" disabled selected>Select a question</option>
                                    <option value="What is your pet name?">What is your pet name?</option>
                                    <option value="What is your mother's maiden name?">Mother's maiden name?</option>
                                    <option value="Which city were you born in?">City of birth?</option>
                                </select>
                            </div>

                            <div class="col-12 modern-field mb-4">
                                <label><i class="fas fa-user-shield me-2"></i>Answer</label>
                                <input type="text" name="security_answer" placeholder="Your secret answer" required>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn-elite-action" style="background: #4f46e5;">
                            Register Now <i class="fas fa-rocket ms-2"></i>
                        </button>
                    </form>
                    
                    <div class="text-center mt-3">
                        <span class="small text-muted">Member? <a href="/login" class="fw-bold text-indigo" style="text-decoration: none;">Sign In</a></span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Compact Styling */
    .elite-wrapper { height: 100vh; width: 100vw; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: #020617; }
    .cinematic-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: cover; background-position: center; z-index: -1; }

    /* Reduced Box Size */
    .split-glass-box { display: flex; width: 85%; max-width: 900px; min-height: 500px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border-radius: 30px; overflow: hidden; box-shadow: 0 40px 80px rgba(0,0,0,0.5); }
    
    .brand-panel { flex: 1; padding: 40px; display: flex; align-items: center; color: white; background: rgba(10, 15, 30, 0.6); }
    .master-heading { font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; line-height: 1; margin-bottom: 15px; }
    .master-heading span { color: #818cf8; }
    
    .status-indicator { display: inline-block; padding: 4px 12px; background: rgba(129, 140, 248, 0.15); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.3); border-radius: 100px; font-size: 0.65rem; font-weight: 700; margin-bottom: 15px; letter-spacing: 1px; }
    .tagline { font-size: 0.9rem; color: rgba(255,255,255,0.7); line-height: 1.4; margin-bottom: 20px; }
    .feature-badges span { background: rgba(255,255,255,0.1); padding: 8px 15px; border-radius: 10px; font-size: 0.75rem; border: 1px solid rgba(255,255,255,0.1); }

    /* Compact Form Styling */
    .form-panel { flex: 1.2; background: white; padding: 30px 40px; display: flex; align-items: center; justify-content: center; }
    .auth-box { width: 100%; max-width: 320px; }
    
    .modern-field label { display: block; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #64748b; margin-bottom: 4px; }
    .modern-field input, .modern-field select { width: 100%; padding: 10px 14px; border-radius: 10px; border: 1.5px solid #e2e8f0; background: #f8fafc; outline: none; transition: 0.3s; font-size: 0.85rem; }
    .modern-field input:focus, .modern-field select:focus { border-color: #6366f1; background: white; }

    .btn-elite-action { width: 100%; padding: 12px; border-radius: 12px; color: white; border: none; font-weight: 700; transition: 0.3s; font-size: 0.9rem; }
    .btn-elite-action:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3); }
    
    @media (max-width: 992px) { .brand-panel { display: none; } .split-glass-box { max-width: 450px; } .form-panel { padding: 30px; } }
</style>

<%- include('partials/footer') %>