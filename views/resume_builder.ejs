<%- include('partials/header') %>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="color: #2d3748;"><i class="fas fa-file-alt text-primary"></i> Resume Builder</h1>
        <p class="text-muted">Fill in your details to generate a professional, ATS-friendly resume instantly.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-body p-5">
                    <form action="/generate-resume" method="POST">
                        
                        <h5 class="fw-bold text-primary mb-3">1. Personal Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" name="fullName" value="<%= user.username %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address</label>
                                <input type="email" class="form-control" name="email" value="<%= user.email %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="text" class="form-control" name="phone" placeholder="+91 9876543210" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">LinkedIn Profile URL</label>
                                <input type="url" class="form-control" name="linkedin" placeholder="https://linkedin.com/in/yourprofile">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">GitHub Profile URL</label>
                                <input type="url" class="form-control" name="github" placeholder="https://github.com/yourusername">
                            </div>
                        </div>

                        <h5 class="fw-bold text-primary mb-3">2. Education & Skills</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label class="form-label">Highest Degree / College</label>
                                <input type="text" class="form-control" name="education" placeholder="B.Tech in Computer Science, XYZ College" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">CGPA / Percentage</label>
                                <input type="text" class="form-control" name="cgpa" placeholder="8.5 or 85%" required>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Technical Skills (Comma separated)</label>
                                <input type="text" class="form-control" name="skills" placeholder="Java, Python, SQL, React, Node.js" required>
                            </div>
                        </div>

                        <h5 class="fw-bold text-primary mb-3">3. Projects & Experience</h5>
                        <div class="mb-3">
                            <label class="form-label">Key Projects (Brief description)</label>
                            <textarea class="form-control" name="projects" rows="3" placeholder="Developed a Placement Portal using Node.js and EJS..." required></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Experience / Internships (Optional)</label>
                            <textarea class="form-control" name="experience" rows="2" placeholder="Intern at XYZ Company as a Web Developer..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">
                                <i class="fas fa-magic me-2"></i> Generate My Resume
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>