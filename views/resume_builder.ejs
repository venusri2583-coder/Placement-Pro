<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Master Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body style="background-color: #f8f9fa;">

<nav class="navbar navbar-dark bg-dark mb-4 shadow">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/"><i class="fas fa-graduation-cap text-warning"></i> PlacementPro</a>
        <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    </div>
</nav>

<div class="container py-3">
    <div class="card bg-dark text-white text-center mb-4 border-0 shadow-lg" style="border-radius: 15px;">
        <div class="card-body py-4">
            <h2 class="fw-bold m-0">Resume <span class="text-danger">Master Hub</span> <i class="fas fa-file-alt"></i></h2>
            <p class="text-light opacity-75 m-0 mt-2">Build professional ATS profiles with real-time dynamic modules.</p>
        </div>
    </div>

    <div class="card shadow border-0" style="border-radius: 15px;">
        <div class="card-body p-4 p-md-5">
            <h4 class="fw-bold mb-4" style="color: #2c3e50;"><i class="fas fa-pen text-primary me-2"></i> Build Professional ATS Profile</h4>
            
            <form action="/generate-resume" method="POST">
                
                <h6 class="fw-bold text-info mb-3">1. Personal & Social Details</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Full Name</label>
                        <input type="text" class="form-control bg-light" name="fullName" value="<%= user.username %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Phone Number</label>
                        <input type="text" class="form-control bg-light" name="phone" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Persona Type</label>
                        <select class="form-select bg-light" name="personaType">
                            <option value="Fresher">Fresher</option>
                            <option value="Experienced">Experienced</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">LinkedIn URL</label>
                        <input type="url" class="form-control bg-light" name="linkedin">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">GitHub URL</label>
                        <input type="url" class="form-control bg-light" name="github">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold small">Email Address</label>
                        <input type="email" class="form-control bg-light border-danger" name="email" value="<%= user.email %>" required>
                    </div>
                </div>

                <h6 class="fw-bold text-info mb-3">2. Career Objective</h6>
                <div class="mb-4">
                    <textarea class="form-control bg-light" name="objective" rows="2" placeholder="Briefly state your career goals..." required></textarea>
                </div>

                <h6 class="fw-bold text-info mb-3">3. Technical Projects (Click + to add more)</h6>
                <div id="projects-container" class="mb-4 p-3 bg-light rounded border">
                    <div class="project-item mb-3 row align-items-center">
                        <div class="col-md-11">
                            <input type="text" class="form-control mb-2" name="projectTitle[]" placeholder="Project Title (e.g. E-Commerce Web App)">
                            <textarea class="form-control" name="projectDesc[]" rows="2" placeholder="Describe features, tech stack used, and your role..."></textarea>
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-primary btn-sm rounded-circle shadow" onclick="addProject()"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-info mb-3">4. Educational Background (Click + to add more degrees)</h6>
                <div id="education-container" class="mb-4 p-3 bg-light rounded border">
                    <div class="education-item mb-3 row align-items-center">
                        <div class="col-md-11">
                            <div class="row g-2">
                                <div class="col-md-3"><input type="text" class="form-control" name="eduDegree[]" placeholder="Degree (e.g. B.Tech/M.Tech)"></div>
                                <div class="col-md-4"><input type="text" class="form-control" name="eduInstitution[]" placeholder="College / University Name"></div>
                                <div class="col-md-3"><input type="text" class="form-control" name="eduLocation[]" placeholder="Location (City)"></div>
                                <div class="col-md-2"><input type="text" class="form-control" name="eduScore[]" placeholder="CGPA / %"></div>
                            </div>
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-primary btn-sm rounded-circle shadow" onclick="addEducation()"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                    
                    <div class="education-item mb-3 row align-items-center border-top pt-3">
                        <div class="col-md-11">
                            <div class="row g-2">
                                <div class="col-md-3"><input type="text" class="form-control" name="eduDegree[]" placeholder="Inter/Diploma" value="Intermediate"></div>
                                <div class="col-md-4"><input type="text" class="form-control" name="eduInstitution[]" placeholder="College Name"></div>
                                <div class="col-md-3"><input type="text" class="form-control" name="eduLocation[]" placeholder="Location"></div>
                                <div class="col-md-2"><input type="text" class="form-control" name="eduScore[]" placeholder="Marks %"></div>
                            </div>
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-danger btn-sm rounded-circle shadow" onclick="this.parentElement.parentElement.remove()"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>

                    <div class="education-item mb-2 row align-items-center border-top pt-3">
                        <div class="col-md-11">
                            <div class="row g-2">
                                <div class="col-md-3"><input type="text" class="form-control" name="eduDegree[]" placeholder="10th Standard" value="10th Standard"></div>
                                <div class="col-md-4"><input type="text" class="form-control" name="eduInstitution[]" placeholder="School Name"></div>
                                <div class="col-md-3"><input type="text" class="form-control" name="eduLocation[]" placeholder="Location"></div>
                                <div class="col-md-2"><input type="text" class="form-control" name="eduScore[]" placeholder="GPA"></div>
                            </div>
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-danger btn-sm rounded-circle shadow" onclick="this.parentElement.parentElement.remove()"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                </div>
        <h6 class="fw-bold text-info mb-3">5. Expertise & Achievements</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Technical Skills (Comma separated)</label>
                        <textarea class="form-control bg-light" name="skills" rows="2" placeholder="Java, Python, React..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Core Strengths</label>
                        <textarea class="form-control bg-light" name="strengths" rows="2" placeholder="Communication, Teamwork..."></textarea>
                    </div>
                    
                    <div class="col-md-12">
                        <label class="form-label fw-bold small">Certifications & Awards (Click + to add more)</label>
                        <div id="cert-container">
                            <div class="input-group mb-2">
                                <input type="text" class="form-control bg-light" name="certifications[]" placeholder="AWS Certified, SIH Winner...">
                                <button class="btn btn-primary shadow-sm" type="button" onclick="addCertification()"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Languages Known</label>
                        <input type="text" class="form-control bg-light" name="languages" placeholder="English, Telugu, Hindi">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small">Personal Hobbies</label>
                        <input type="text" class="form-control bg-light" name="hobbies" placeholder="Reading, Coding, Chess">
                    </div>
                </div>

                <hr class="my-4">

                <div class="row align-items-center bg-light p-3 rounded border">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="fw-bold text-dark mb-1"><i class="fas fa-palette text-warning"></i> Choose Template</label>
                        <select class="form-select border-primary" name="templateType">
                            <option value="template1">Modern ATS Format (Recommended)</option>
                            <option value="template2">Classic Professional</option>
                        </select>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow"><i class="fas fa-save"></i> Save & Generate Final</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
<script>
    // 🔥 1. ప్రాజెక్ట్స్ యాడ్ చేయడానికి
    function addProject() {
        const container = document.getElementById('projects-container');
        const div = document.createElement('div');
        div.className = 'project-item mb-3 row align-items-center mt-3 border-top pt-3';
        div.innerHTML = `
            <div class="col-md-11">
                <input type="text" class="form-control mb-2" name="projectTitle[]" placeholder="Project Title">
                <textarea class="form-control" name="projectDesc[]" rows="2" placeholder="Describe features..."></textarea>
            </div>
            <div class="col-md-1 text-center">
                <button type="button" class="btn btn-danger btn-sm rounded-circle shadow" onclick="this.parentElement.parentElement.remove()"><i class="fas fa-trash"></i></button>
            </div>
        `;
        container.appendChild(div);
    }

    // 🔥 2. ఎడ్యుకేషన్ యాడ్ చేయడానికి 
    function addEducation() {
        const container = document.getElementById('education-container');
        const div = document.createElement('div');
        div.className = 'education-item mb-3 row align-items-center mt-3 border-top pt-3';
        div.innerHTML = `
            <div class="col-md-11">
                <div class="row g-2">
                    <div class="col-md-3"><input type="text" class="form-control" name="eduDegree[]" placeholder="Degree (e.g. M.Tech)"></div>
                    <div class="col-md-4"><input type="text" class="form-control" name="eduInstitution[]" placeholder="Institution Name"></div>
                    <div class="col-md-3"><input type="text" class="form-control" name="eduLocation[]" placeholder="Location"></div>
                    <div class="col-md-2"><input type="text" class="form-control" name="eduScore[]" placeholder="Score"></div>
                </div>
            </div>
            <div class="col-md-1 text-center">
                <button type="button" class="btn btn-danger btn-sm rounded-circle shadow" onclick="this.parentElement.parentElement.remove()"><i class="fas fa-trash"></i></button>
            </div>
        `;
        container.appendChild(div);
    }

    // 🔥 3. సర్టిఫికెట్స్ యాడ్ చేయడానికి (ఇదే కొత్తది)
    function addCertification() {
        const container = document.getElementById('cert-container');
        const div = document.createElement('div');
        div.className = 'input-group mb-2 mt-2';
        div.innerHTML = `
            <input type="text" class="form-control bg-light" name="certifications[]" placeholder="Add another certificate or award">
            <button class="btn btn-danger shadow-sm" type="button" onclick="this.parentElement.remove()"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(div);
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>