<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.fullName %> - Resume</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { font-family: 'Arial', sans-serif; background: #f4f7f6; }
        .resume-container { background: white; max-width: 800px; margin: 40px auto; padding: 50px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .resume-header { border-bottom: 2px solid #2c3e50; padding-bottom: 20px; margin-bottom: 30px; }
        .section-title { color: #2c3e50; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-bottom: 15px; margin-top: 30px; }
        .contact-info i { color: #2980b9; margin-right: 8px; }
        .contact-info span { margin-right: 15px; font-size: 0.95rem; }
        /* ప్రింట్ కొట్టేటప్పుడు బటన్స్ కనపడకుండా ఉండటానికి */
        @media print {
            body { background: white; }
            .resume-container { box-shadow: none; margin: 0; padding: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>

<div class="text-center mt-4 no-print">
    <button onclick="window.print()" class="btn btn-success btn-lg shadow rounded-pill px-4 me-2">
        <i class="fas fa-download"></i> Download / Print as PDF
    </button>
    <a href="/resume-builder" class="btn btn-secondary btn-lg shadow rounded-pill px-4">
        <i class="fas fa-edit"></i> Edit Details
    </a>
</div>

<div class="resume-container">
    <div class="resume-header text-center">
        <h1 class="fw-bold text-uppercase" style="color: #2c3e50; font-size: 2.5rem;"><%= data.fullName %></h1>
        <div class="contact-info mt-3">
            <span><i class="fas fa-envelope"></i> <%= data.email %></span>
            <span><i class="fas fa-phone"></i> <%= data.phone %></span>
            <% if(data.linkedin) { %><span><i class="fab fa-linkedin"></i> <%= data.linkedin %></span><% } %>
            <% if(data.github) { %><span><i class="fab fa-github"></i> <%= data.github %></span><% } %>
        </div>
    </div>

    <h4 class="section-title">Education</h4>
    <div class="mb-3">
        <h5 class="fw-bold mb-1"><%= data.education %></h5>
        <p class="text-muted mb-0"><strong>CGPA / Percentage:</strong> <%= data.cgpa %></p>
    </div>

    <h4 class="section-title">Technical Skills</h4>
    <div class="mb-3">
        <ul style="padding-left: 20px;">
            <% data.skills.forEach(skill => { %>
                <li style="font-size: 1.1rem; margin-bottom: 5px;"><%= skill.trim() %></li>
            <% }) %>
        </ul>
    </div>

    <h4 class="section-title">Key Projects</h4>
    <div class="mb-3">
        <p style="font-size: 1.05rem; line-height: 1.6; white-space: pre-wrap;"><%= data.projects %></p>
    </div>

    <% if(data.experience) { %>
    <h4 class="section-title">Experience & Internships</h4>
    <div class="mb-3">
        <p style="font-size: 1.05rem; line-height: 1.6; white-space: pre-wrap;"><%= data.experience %></p>
    </div>
    <% } %>

</div>

</body>
</html>