<!DOCTYPE html>
<html>
<head>
    <title><%= data.fullName %> - Resume</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #555; }
        .page { background: white; max-width: 800px; margin: auto; padding: 40px; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
        h1 { color: #2c3e50; text-transform: uppercase; border-bottom: 2px solid #2c3e50; padding-bottom: 5px; margin-bottom: 5px; }
        .contact { font-size: 14px; color: #555; margin-bottom: 20px; }
        h3 { color: #2980b9; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 20px; }
        p, li { font-size: 14px; line-height: 1.5; color: #333; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 13px; }
        th { background-color: #f2f2f2; }
        .skills-container { display: flex; flex-wrap: wrap; gap: 10px; }
        .skill-badge { background: #e9ecef; padding: 5px 10px; border-radius: 15px; font-size: 13px; font-weight: bold; }
        @media print { body { background: white; padding: 0; } .page { box-shadow: none; max-width: 100%; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print" style="text-align: center; margin-bottom: 20px;">
        <button onclick="window.print()" style="padding: 10px 20px; background: green; color: white; border: none; cursor: pointer; font-size: 16px;">🖨️ Download PDF</button>
    </div>
    <div class="page">
        <h1><%= data.fullName %></h1>
        <div class="contact">
            Email: <%= data.email %> | Phone: <%= data.phone %> <br>
            <% if(data.linkedin) { %> LinkedIn: <%= data.linkedin %> | <% } %>
            <% if(data.github) { %> GitHub: <%= data.github %> <% } %>
        </div>

        <h3>CAREER OBJECTIVE</h3>
        <p><%= data.objective %></p>

        <h3>EDUCATION</h3>
        <table>
            <tr><th>Degree</th><th>Institution</th><th>Location</th><th>Score</th></tr>
            <tr><td><%= data.education.btech.degree %></td><td><%= data.education.btech.college %></td><td><%= data.education.btech.city %></td><td><%= data.education.btech.cgpa %></td></tr>
            <tr><td><%= data.education.inter.degree %></td><td><%= data.education.inter.college %></td><td><%= data.education.inter.city %></td><td><%= data.education.inter.marks %></td></tr>
            <tr><td><%= data.education.ssc.degree %></td><td><%= data.education.ssc.school %></td><td><%= data.education.ssc.city %></td><td><%= data.education.ssc.cgpa %></td></tr>
        </table>

        <h3>TECHNICAL SKILLS</h3>
        <div class="skills-container">
            <% data.skills.forEach(skill => { %> <span class="skill-badge"><%= skill %></span> <% }) %>
        </div>

        <h3>PROJECTS</h3>
        <% data.projects.forEach(proj => { %>
            <p><strong><%= proj.title %>:</strong> <%= proj.description %></p>
        <% }) %>

        <% if(data.certifications.length > 0) { %>
        <h3>CERTIFICATIONS & ACHIEVEMENTS</h3>
        <ul> <% data.certifications.forEach(cert => { %> <li><%= cert %></li> <% }) %> </ul>
        <% } %>
    </div>
</body>
</html>
