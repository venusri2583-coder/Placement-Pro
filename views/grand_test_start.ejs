<%- include('partials/header') %>
<div class="container mt-5">
    <div class="card shadow-lg border-0" style="border-radius: 20px;">
        <div class="card-body p-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-dark" style="line-height: 1.5;">
                    <i class="fas fa-quote-left text-primary opacity-50 me-2" style="font-size: 1.2rem;"></i>
                    Success is where preparation and opportunity meet.
                </h2>
                <p class="text-muted mt-3" style="font-size: 1.1rem; font-weight: 500;">
                    Comprehensive Skills Evaluation <span class="mx-2 text-primary">|</span> Standard Industry Assessment
                </p>
            </div>

            <div class="row align-items-center">
                <div class="col-md-6 mb-4 text-center">
                    <img src="https://img.freepik.com/free-vector/online-certification-illustration_23-2148575636.jpg" style="max-width: 80%; border-radius: 15px;">
                </div>
                <div class="col-md-6">
                    <div class="bg-light p-4 rounded-3 border">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Exam Pattern:</h5>
                        <ul class="list-unstyled mb-4" style="font-size: 1.1rem;">
                            <li class="mb-2"><i class="fas fa-calculator text-primary me-2"></i> <strong>Aptitude:</strong> 20 Qs</li>
                            <li class="mb-2"><i class="fas fa-brain text-warning me-2"></i> <strong>Reasoning:</strong> 20 Qs</li>
                            <li class="mb-2"><i class="fas fa-book text-success me-2"></i> <strong>English:</strong> 20 Qs</li>
                            <li class="mb-2"><i class="fas fa-laptop-code text-info me-2"></i> <strong>Technical:</strong> 20 Qs</li>
                            <li class="mb-2 pt-2 border-top text-danger fw-bold"><i class="fas fa-stopwatch me-2"></i> <strong>Time Limit:</strong> 80 Minutes</li>
                        </ul>

                        <div class="alert alert-warning border-0 small mb-4">
                            <i class="fas fa-exclamation-triangle me-1"></i> <strong>Warning:</strong> Tab switching or minimizing the window will result in automatic submission.
                        </div>

                        <form action="/start-grand-exam" method="GET">
                            <div class="mb-4 text-start">
                                <label for="difficulty" class="form-label fw-bold text-dark">Select Difficulty Level:</label>
                                <select class="form-select form-control form-control-lg border-2" name="difficulty" id="difficulty" style="cursor: pointer; font-weight: 500;">
                                    <option value="All">🔄 Mixed (Standard MNC Pattern)</option>
                                    <option value="Basic">🟢 Basic (Easy Level)</option>
                                    <option value="Medium">🟡 Medium (Moderate Level)</option>
                                    <option value="Advanced">🔴 Hard (Advanced Level)</option>
                                </select>
                            </div>
                            
                            <button type="submit" class="btn btn-dark w-100 py-3 fw-bold shadow">
                                Start Mega Test Now <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>